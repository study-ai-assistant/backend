# Скопируйте в .env в корне backend. Не перезаписывайте свой существующий файл.
# Формат KEY=value, без export и кавычек; каждое имя указать один раз.
# Переменные окружения процесса имеют приоритет над .env.
# Для /health ключ не нужен. Для обработки текста заполните все четыре LLM-настройки.
# Сейчас реализован провайдер groq.
LLM_PROVIDER=
# Например openai/gpt-oss-120b.
LLM_MODEL=
# Личный действующий ключ Groq. Не публиковать и не коммитить.
LLM_API_KEY=
# Для Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Пустое значение использует порт 8080. После изменений перезапустите сервер.
APP_PORT=
