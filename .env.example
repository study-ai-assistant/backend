# Скопируйте в .env; заполните только свой локальный файл.
# Формат KEY=value, без export и кавычек. Пустой APP_PORT означает порт 8080.
# Переменные окружения процесса имеют приоритет. Не коммитьте реальные ключи.
# Например, провайдер groq (каждый разработчик выбирает своего).
LLM_PROVIDER=
# Название модели выбранного провайдера.
# Пример переменных окружения для сервера.
# Скопируйте этот файл в .env и заполните значения ЛОКАЛЬНО.
# Файл .env не коммитится (он в .gitignore). Реальные ключи никогда не попадают в репозиторий.

# --- LLM-провайдер ---
# Провайдера и ключ каждый разработчик выбирает и получает сам — тот, которым ему удобнее пользоваться.
# Кто каким провайдером пользуется — в wiki «Интеграция с LLM».
# Название провайдера LLM API
LLM_PROVIDER=
# Ваш личный ключ доступа к LLM API. Никому не пересылать и никуда не публиковать.
LLM_API_KEY=
# Модель, которую использует сервер
LLM_MODEL=
# Свой ключ из личного кабинета провайдера; не отправлять в чат и логи.
LLM_API_KEY=
# Базовый URL выбранного API.
LLM_BASE_URL=
# Необязательный порт сервера; по умолчанию 8080.
APP_PORT=
