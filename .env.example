# Скопируйте в .env; заполните только свой локальный файл.
# Формат KEY=value, без export и кавычек. Пустой APP_PORT означает порт 8080.
# Переменные окружения процесса имеют приоритет. Не коммитьте реальные ключи.
# Например, провайдер groq (каждый разработчик выбирает своего).
LLM_PROVIDER=
# Название модели выбранного провайдера.
LLM_MODEL=
# Свой ключ из личного кабинета провайдера; не отправлять в чат и логи.
LLM_API_KEY=
# Базовый URL выбранного API.
LLM_BASE_URL=
# Необязательный порт сервера; по умолчанию 8080.
APP_PORT=
