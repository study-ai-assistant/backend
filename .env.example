# Пример переменных окружения для сервера.
# Скопируйте этот файл в .env и заполните значения ЛОКАЛЬНО.
# Файл .env не коммитится (он в .gitignore). Реальные ключи никогда не попадают в репозиторий.

# --- LLM-провайдер ---
# Провайдера и ключ каждый разработчик выбирает и получает сам — тот, которым ему удобнее пользоваться.
# Кто каким провайдером пользуется — в wiki «Интеграция с LLM».
# Название провайдера LLM API
LLM_PROVIDER=
# Ваш личный ключ доступа к LLM API. Никому не пересылать и никуда не публиковать.
LLM_API_KEY=
# Модель, которую использует сервер
LLM_MODEL=
# Адрес API провайдера (если отличается от адреса по умолчанию)
LLM_BASE_URL=

# --- Сервер (ЗАПОЛНИТЬ после выбора стека) ---
# Порт, на котором запускается сервер
APP_PORT=
# Максимальный размер загружаемого текста (в символах)
MAX_INPUT_CHARS=
