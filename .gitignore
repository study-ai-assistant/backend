# Универсальный минимум. Правила для выбранного стека добавим после его выбора.

# Переменные окружения и секреты (пример настроек — в .env.example)
.env
.env.*
!.env.example

# IDE и редакторы
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.fleet/

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Логи
*.log
logs/

# Временные файлы
tmp/
*.tmp

# Java: скомпилированные классы и отчёты о сбоях JVM
*.class
hs_err_pid*
replay_pid*

# Maven: результаты сборки
target/

# Дополнительные файлы Eclipse / Spring Tool Suite
.classpath
.project
.settings/

# Результаты сборки IntelliJ IDEA
out/